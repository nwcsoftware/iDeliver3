# Copy this file to .env and fill in your Supabase project credentials
# Found at: https://supabase.com/dashboard → your project → Settings → API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
# UUID of your company row in the companies table (from seed data)
VITE_COMPANY_ID=your-company-uuid-here
